# Google AI Studio key. Create a FRESH key at https://aistudio.google.com/apikey
# (new keys are "auth keys"; older unrestricted standard keys are rejected by the Gemini API).
# Copy this file to .env and paste the key. .env is git-ignored; never commit it.
GOOGLE_API_KEY=

# Optional overrides (defaults shown). Free-tier limits are per project and unpublished:
# check https://aistudio.google.com/rate-limit before changing the model.
# NOVAMART_MODEL=gemini-3.5-flash          # agent model (gemini-3.5-flash-lite if your quota is tight)
# NOVAMART_JUDGE_MODEL=gemini-2.5-flash    # eval judge; a 2.5 model so temperature=0 is legal
# NOVAMART_MIN_SCORE=0.50                  # retrieval confidence gate (cosine); hand-set default, not yet swept
# NOVAMART_TOP_K=4

# Leave GOOGLE_GENAI_USE_ENTERPRISE / GOOGLE_GENAI_USE_VERTEXAI unset: the prototype targets AI Studio only.
