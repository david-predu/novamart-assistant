# Google AI Studio key. Create a FRESH key at https://aistudio.google.com/apikey
# (new keys are "auth keys"; older unrestricted standard keys are rejected by the Gemini API).
# Copy this file to .env and paste the key. .env is git-ignored; never commit it.
GOOGLE_API_KEY=

# Optional overrides (defaults shown). Free-tier limits are per project and unpublished:
# check https://aistudio.google.com/rate-limit before changing the model.
# NOVAMART_MODEL=gemini-3.5-flash-lite     # agent model; gemini-3.5-flash gave this project only 20 free requests/day (429 quota message, 2026-09-10)
# NOVAMART_JUDGE_MODEL=gemini-3.6-flash    # eval judge; gemini-2.5-* returned 404 'no longer available to new users' (2026-09-10)
# NOVAMART_MIN_SCORE=0.66                  # retrieval gate (cosine): midpoint of the verbatim golden-question sweep in commit 3166fb2 - best clean out-of-scope 0.627, weakest grounded 0.702
# NOVAMART_TOP_K=4
# NOVAMART_LOG_LEVEL=WARNING               # CLI log level; DEBUG shows ADK's request/response logs

# Leave GOOGLE_GENAI_USE_ENTERPRISE / GOOGLE_GENAI_USE_VERTEXAI unset: the prototype targets AI Studio only.
